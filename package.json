{
  "name": "eigenlvr-v2",
  "version": "1.0.0",
  "description": "EigenLVR Evolution: Next-Generation MEV Protection with Cross-Chain + FHE Integration",
  "keywords": ["eigenlayer", "uniswap", "fhe", "mev", "cross-chain", "fhenix"],
  "scripts": {
    "install": "pnpm install && forge install",
    "build": "forge build",
    "test": "forge test",
    "test:verbose": "forge test -vvv",
    "test:gas": "forge test --gas-report",
    "coverage": "forge coverage --ir-minimum",
    "format": "forge fmt",
    "lint": "forge fmt --check",
    "deploy:anvil": "forge script script/DeployEigenLVRv2.s.sol --rpc-url http://localhost:8545 --broadcast",
    "start:anvil": "anvil --host 0.0.0.0 --port 8545"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.0",
    "@uniswap/v4-core": "latest",
    "@uniswap/v4-periphery": "latest", 
    "@fhenixprotocol/cofhe-contracts": "latest",
    "@across-protocol/contracts": "latest"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-foundry": "^1.1.1",
    "hardhat": "^2.19.0",
    "typescript": "^5.3.0"
  }
}