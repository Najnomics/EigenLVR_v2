# EigenLVR v2 Environment Configuration
# Copy this file to .env and fill in your values

# =============================================================================
# RPC URLs
# =============================================================================

# Ethereum Mainnet
ETHEREUM_RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY
# Alternative: https://eth-mainnet.alchemyapi.io/v2/YOUR_ALCHEMY_KEY

# Ethereum Sepolia Testnet
ETHEREUM_SEPOLIA_RPC_URL=https://sepolia.infura.io/v3/YOUR_INFURA_KEY

# Arbitrum One
ARBITRUM_RPC_URL=https://arbitrum-mainnet.infura.io/v3/YOUR_INFURA_KEY
# Alternative: https://arb1.arbitrum.io/rpc

# Arbitrum Sepolia Testnet
ARBITRUM_SEPOLIA_RPC_URL=https://sepolia-rollup.arbitrum.io/rpc

# Optimism
OPTIMISM_RPC_URL=https://optimism-mainnet.infura.io/v3/YOUR_INFURA_KEY
# Alternative: https://mainnet.optimism.io

# Optimism Sepolia Testnet
OPTIMISM_SEPOLIA_RPC_URL=https://sepolia.optimism.io

# Polygon
POLYGON_RPC_URL=https://polygon-mainnet.infura.io/v3/YOUR_INFURA_KEY
# Alternative: https://polygon-rpc.com

# Base
BASE_RPC_URL=https://mainnet.base.org
# Alternative: https://base-mainnet.infura.io/v3/YOUR_INFURA_KEY

# =============================================================================
# PRIVATE KEYS
# =============================================================================

# Main deployment private key (keep secure!)
PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Operator private key for AVS
OPERATOR_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# Fhenix private key
FHENIX_PRIVATE_KEY=0x1234567890abcdef1234567890abcdef1234567890abcdef1234567890abcdef

# =============================================================================
# API KEYS
# =============================================================================

# Infura API Key
INFURA_KEY=your_infura_project_id_here

# Alchemy API Key
ALCHEMY_KEY=your_alchemy_api_key_here

# Etherscan API Key (for contract verification)
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Arbiscan API Key
ARBISCAN_API_KEY=your_arbiscan_api_key_here

# Optimism Etherscan API Key
OPTIMISM_ETHERSCAN_API_KEY=your_optimism_etherscan_api_key_here

# =============================================================================
# FHENIX CONFIGURATION
# =============================================================================

# Fhenix RPC URL
FHENIX_RPC_URL=https://api.fhenix.zone
# Alternative: https://testnet.fhenix.zone (for testnet)

# Fhenix Chain ID
FHENIX_CHAIN_ID=42069

# Fhenix Explorer URL
FHENIX_EXPLORER_URL=https://explorer.fhenix.zone

# =============================================================================
# EIGENLAYER CONFIGURATION
# =============================================================================

# EigenLayer AVS Address
EIGENLAYER_AVS_ADDRESS=0x1234567890123456789012345678901234567890

# EigenLayer Service Manager Address
EIGENLAYER_SERVICE_MANAGER_ADDRESS=0x1234567890123456789012345678901234567890

# EigenLayer Operator Address
EIGENLAYER_OPERATOR_ADDRESS=0x1234567890123456789012345678901234567890

# EigenLayer Stake Amount (in wei)
EIGENLAYER_STAKE_AMOUNT=1000000000000000000000

# =============================================================================
# ORACLE CONFIGURATION
# =============================================================================

# Chainlink Oracle Addresses
CHAINLINK_ETH_USD_ORACLE=0x5f4eC3Df9cbd43714FE2740f5E3616155c5b8419
CHAINLINK_BTC_USD_ORACLE=0xF4030086522e5b6c0c0c0c0c0c0c0c0c0c0c0c0c0

# Pyth Oracle Addresses
PYTH_ETH_USD_ORACLE=0x1234567890123456789012345678901234567890
PYTH_BTC_USD_ORACLE=0x1234567890123456789012345678901234567890

# =============================================================================
# CROSS-CHAIN CONFIGURATION
# =============================================================================

# Across Protocol Hub Pool Address
ACROSS_HUB_POOL_ADDRESS=0x1234567890123456789012345678901234567890

# LayerZero Endpoint Address
LAYERZERO_ENDPOINT_ADDRESS=0x1234567890123456789012345678901234567890

# Wormhole Bridge Address
WORMHOLE_BRIDGE_ADDRESS=0x1234567890123456789012345678901234567890

# =============================================================================
# CONTRACT ADDRESSES (Deployed)
# =============================================================================

# EigenLVR v2 Hook Address
EIGENLVR_V2_ADDRESS=0x1234567890123456789012345678901234567890

# Cross-Chain Price Monitor Address
CROSS_CHAIN_MONITOR_ADDRESS=0x1234567890123456789012345678901234567890

# Private Auction Manager Address
PRIVATE_AUCTION_MANAGER_ADDRESS=0x1234567890123456789012345678901234567890

# Chain Registry Address
CHAIN_REGISTRY_ADDRESS=0x1234567890123456789012345678901234567890

# =============================================================================
# MONITORING & ALERTING
# =============================================================================

# Discord Webhook URL
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_URL

# Slack Webhook URL
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_SLACK_WEBHOOK

# Telegram Bot Token
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Telegram Chat ID
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# PostgreSQL Database URL
DATABASE_URL=postgresql://username:password@localhost:5432/eigenlvr

# Redis URL
REDIS_URL=redis://localhost:6379

# MongoDB URL
MONGODB_URL=mongodb://localhost:27017/eigenlvr

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================

# Log Level (debug, info, warn, error)
LOG_LEVEL=info

# Log Format (json, text)
LOG_FORMAT=json

# Log File Path
LOG_FILE_PATH=./logs/eigenlvr.log

# =============================================================================
# PERFORMANCE CONFIGURATION
# =============================================================================

# Gas Price Multiplier
GAS_PRICE_MULTIPLIER=1.1

# Max Gas Price (in gwei)
MAX_GAS_PRICE=100

# Transaction Timeout (in seconds)
TX_TIMEOUT=300

# Retry Attempts
RETRY_ATTEMPTS=3

# =============================================================================
# SECURITY CONFIGURATION
# =============================================================================

# JWT Secret Key
JWT_SECRET=your_jwt_secret_key_here

# API Rate Limit (requests per minute)
API_RATE_LIMIT=1000

# CORS Origins
CORS_ORIGINS=https://app.eigenlvr.com,https://staging.eigenlvr.com

# =============================================================================
# FEATURE FLAGS
# =============================================================================

# Enable Cross-Chain Features
ENABLE_CROSS_CHAIN=true

# Enable FHE Features
ENABLE_FHE=true

# Enable Private Auctions
ENABLE_PRIVATE_AUCTIONS=true

# Enable Monitoring
ENABLE_MONITORING=true

# Enable Metrics
ENABLE_METRICS=true

# =============================================================================
# DEVELOPMENT CONFIGURATION
# =============================================================================

# Development Mode
DEV_MODE=false

# Debug Mode
DEBUG_MODE=false

# Test Mode
TEST_MODE=false

# Mock External Services
MOCK_EXTERNAL_SERVICES=false

# =============================================================================
# DEPLOYMENT CONFIGURATION
# =============================================================================

# Deployment Environment
DEPLOYMENT_ENV=production
# Options: development, staging, production

# Deployment Network
DEPLOYMENT_NETWORK=ethereum
# Options: ethereum, arbitrum, optimism, polygon, base

# Contract Verification
VERIFY_CONTRACTS=true

# Gas Estimation
ESTIMATE_GAS=true

# =============================================================================
# BACKUP CONFIGURATION
# =============================================================================

# Backup Interval (in hours)
BACKUP_INTERVAL=24

# Backup Retention (in days)
BACKUP_RETENTION=30

# Backup Storage Path
BACKUP_STORAGE_PATH=./backups

# =============================================================================
# NOTIFICATION CONFIGURATION
# =============================================================================

# Email SMTP Host
SMTP_HOST=smtp.gmail.com

# Email SMTP Port
SMTP_PORT=587

# Email SMTP Username
SMTP_USERNAME=your_email@gmail.com

# Email SMTP Password
SMTP_PASSWORD=your_app_password_here

# Email From Address
EMAIL_FROM=noreply@eigenlvr.com

# Email To Addresses (comma-separated)
EMAIL_TO=admin@eigenlvr.com,alerts@eigenlvr.com
